<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CFBundleIdentifier / CFBundleShortVersionString / CFBundleVersion are filled in from
	     ApplicationId / ApplicationDisplayVersion / ApplicationVersion in ClassicUO.iOS.csproj. -->
	<key>CFBundleDisplayName</key>
	<string>Graveyard Battles</string>
	<key>CFBundleName</key>
	<string>Graveyard Battles</string>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/AppIcon.appiconset</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>15.0</string>

	<!-- iPhone only: keeps App Store Connect from applying iPad multitasking/screenshot rules. -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>

	<!-- Landscape and portrait (FNA sets SDL_ORIENTATIONS itself; this list is the gate), full screen, no status bar. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIInterfaceOrientation</key>
	<string>UIInterfaceOrientationLandscapeRight</string>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- A launch screen is required, or iOS runs the app letterboxed in legacy-size mode.
	     An empty UILaunchScreen dictionary (iOS 14+) avoids shipping a storyboard. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Let the user copy UO data into Documents/uo with Finder (USB) or the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- The shard is on the local network (ServUO on the Windows PC). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Graveyard Battles connects to a game server on your local network.</string>
	<!-- Plain TCP to a LAN IP is not subject to ATS (ATS covers URLSession/HTTP), kept for any
	     HTTP the client might do (e.g. update checks, web links). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Game controllers (optional; matches the FNA docs). -->
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>

	<!-- SDL3 is linked in whole and references camera, microphone and Bluetooth (game
	     controller) APIs, so App Store Connect requires purpose strings even though the game
	     never asks for these (upload of build 21 failed with ITMS-90683). -->
	<key>NSCameraUsageDescription</key>
	<string>Graveyard Battles does not use the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Graveyard Battles does not use the microphone.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Graveyard Battles uses Bluetooth only to talk to game controllers you pair.</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
